/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xgpio.h"
#include "xparameters.h"
#define LED_DELAY (500000)

int main()
{
	XGpio led;
	XGpio rgb;
	XGpio sws;
	int Status;
	volatile int delay;


    init_platform();

    Status = XGpio_Initialize(&led, XPAR_AXI_GPIO_0_DEVICE_ID);

    Status |= XGpio_Initialize(&led, XPAR_AXI_GPIO_1_DEVICE_ID);

    Status |= XGpio_Initialize(&led, XPAR_AXI_GPIO_2_DEVICE_ID);

    if (Status != XST_SUCCESS)
    {
    	return XST_FAILURE;
    }

    XGpio_SetDataDirection(&led, 1, 0x0);
    XGpio_SetDataDirection(&rgb, 1, 0x0);
    XGpio_SetDataDirection(&sws, 1, 0xF);

    u32 switch_value;
    while(1)
    {
    	switch_value = XGpio_DiscreteRead(&sws, 1);

    	if (switch_value == 0x1) //LED0 = 1; RED RGB
    	{
    		XGpio_DiscreteWrite(&led, 1, 0x1);
    		XGpio_DiscreteWrite(&rgb, 1, 0x1);
    	}
    	else if (switch_value == 0x2)
    	{
    		XGpio_DiscreteWrite(&led, 1, 0x2);
    		XGpio_DiscreteWrite(&rgb, 1, 0x2);
    	}
    	else if (switch_value == 0x4)
    	{
    		XGpio_DiscreteWrite(&led, 1, 0x4);
    		XGpio_DiscreteWrite(&rgb, 1, 0x4);
    	}
    	else if (switch_value == 0x8)
    	{
    		XGpio_DiscreteWrite(&led, 1, 0x8);
    		XGpio_DiscreteWrite(&rgb, 1, 0x7);
    	}
    	else if (switch_value == 0x3)
    	{
    		for (int cnt = 0; cnt <= 0xF; cnt++){
    			XGpio_DiscreteWrite(&led, 1, cnt);
    			XGpio_DiscreteWrite(&rgb, 1, 0x0);
    			for (delay = 0; delay < LED_DELAY; delay++);
    		}
    	}
    	else if (switch_value == 0xC)
    	{
    		for (int cnt = 1; cnt <= 0x8; cnt *= 2){
    			XGpio_DiscreteWrite(&led, 1, cnt);
    			XGpio_DiscreteWrite(&rgb, 1, 0x0);
    			for (delay = 0; delay < LED_DELAY; delay++);
    		}
    	}
    	else{
    		XGpio_DiscreteWrite(&led, 1, 0x0);
    		XGpio_DiscreteWrite(&rgb, 1, 0x0);
    	}
    }

    cleanup_platform();
    return 0;
}
